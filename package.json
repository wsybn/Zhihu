{
  "name": "zhuhuhu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "mock": "json-server --watch mock-server/db.json --port 3000",
    "mock:server": "node mock-server/server.js",
    "knowledge:index": "node server/scripts/indexExistingArticles.js",
    "test:unit": "node --test tests/unit/",
    "test:api": "node --test tests/api/",
    "test:components": "vitest run",
    "test:e2e": "playwright test",
    "test:canary": "node --test tests/canary/",
    "test": "npm run test:unit && npm run test:api && npm run test:components",
    "test:all": "npm run test && npm run test:e2e",
    "test:coverage": "npm run test:coverage:backend && npm run test:coverage:frontend",
    "test:coverage:backend": "c8 --reporter=text --reporter=json-summary node --test tests/unit/ tests/api/",
    "test:coverage:frontend": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bootstrap": "^5.3.8",
    "dotenv": "^18.0.4",
    "marked": "^4.0.0",
    "mitt": "^3.0.1",
    "openai": "^6.49.0",
    "vue": "^3.2.13",
    "vue-router": "^4.6.3",
    "vue-virtual-scroller": "^2.0.1",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-typescript": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/eslint-config-typescript": "^9.1.0",
    "@vue/test-utils": "^2.4.6",
    "c8": "^9.1.0",
    "eslint": "^7.32.0",
    "eslint-config-standard": "^16.0.3",
    "eslint-import-resolver-node": "^0.3.4",
    "eslint-import-resolver-webpack": "^0.13.1",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.1.0",
    "eslint-plugin-vue": "^8.0.3",
    "jsdom": "^24.1.3",
    "json-server": "^0.17.4",
    "multer": "^2.0.2",
    "supertest": "^7.3.0",
    "typescript": "~4.5.5",
    "vitest": "^1.6.1"
  }
}
